# Copy this file to .env.local and fill in the values:
#
#   cp .env.example .env.local
#
# .env.local is gitignored. Never put a real value in THIS file.


# ---------------------------------------------------------------------------
# Supabase — Project Settings → API Keys
#
# Use the NEW key format (sb_publishable_... / sb_secret_...).
# The legacy anon / service_role JWT keys are deprecated by end of 2026.
#
# Both of these are also in Vercel, so `npx vercel env pull .env.local`
# fills them in for you rather than copying by hand.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...


# ---------------------------------------------------------------------------
# Google Gemini — aistudio.google.com → Get API key
#
# Powers the AI tab. Server-side only: it is read in server actions and
# route handlers, never in a client component.
#
# NO NEXT_PUBLIC_ PREFIX. Next.js inlines NEXT_PUBLIC_ values into the
# browser bundle at build time, so prefixing this one would publish your
# key to anyone who opens devtools.
#
# Free tier, chosen 2026-09-22 on cost. Flash and Flash-Lite models, and
# Google Search grounding is included — no separate search API.
#
# On data: Google's free tier normally uses submitted content to improve
# its products. The paid-services data terms apply to EEA/Swiss/UK users on
# all tiers, which is why this is acceptable for an app that will hold bank
# transactions. VERIFY THAT ON GOOGLE'S TERMS PAGE BEFORE IMPORTING A REAL
# STATEMENT — it is a regulatory carve-out, not a promise the free tier
# makes on its own, and terms move.
#
# Mark it Sensitive in Vercel. That makes it write-only there, so
# `vercel env pull` will not bring it down and this local copy is manual.
# ---------------------------------------------------------------------------

GEMINI_API_KEY=...


# ---------------------------------------------------------------------------
# Deliberately NOT set.
#
# SUPABASE_SECRET_KEY (formerly service_role) bypasses row-level security
# entirely. There is no admin surface and no background job that needs it.
# Adding it means one careless server action can undo every RLS policy in
# the project. If something ever genuinely requires it, add it server-side
# only — never with a NEXT_PUBLIC_ prefix.
#
# SUPABASE_SECRET_KEY=sb_secret_...
# ---------------------------------------------------------------------------


# NEXT_PUBLIC_ values are inlined at build time. Changing one in Vercel
# does nothing until you redeploy.
