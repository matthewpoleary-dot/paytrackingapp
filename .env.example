# Supabase — Project Settings → API Keys
# Use the NEW key format (sb_publishable_... / sb_secret_...).
# The legacy anon / service_role JWT keys are deprecated by end of 2026.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Deliberately NOT set.
#
# SUPABASE_SECRET_KEY (formerly service_role) bypasses row-level security
# entirely. v1 has no admin surface and no background jobs, so nothing
# needs it. Adding it means one careless server action can undo every RLS
# policy in the project. If something ever genuinely requires it, add it
# server-side only — never with a NEXT_PUBLIC_ prefix.
#
# SUPABASE_SECRET_KEY=sb_secret_...

# NEXT_PUBLIC_ values are inlined at build time. Changing one in Vercel
# does nothing until you redeploy.

# --- Gemini ------------------------------------------------------------------
# The AI tab. Decided 2026-09-22, replacing Anthropic: the free tier covers
# what one person's budget questions need, and Google Search grounding is
# included in it, which is where every figure about the outside world gets
# its citation.
#
# Get a key at aistudio.google.com/apikey.
#
# Server-side only. A NEXT_PUBLIC_ prefix would inline it into the browser
# bundle and hand the key to anyone who opens devtools.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash, checked against
# ai.google.dev/gemini-api/docs/models on 2026-09-22. Free tier is Flash and
# Flash-Lite only; set this to move models without a deploy.
# GEMINI_MODEL=gemini-3.5-flash
