# Supabase — Project Settings → API Keys
# Use the NEW key format (sb_publishable_... / sb_secret_...).
# The legacy anon / service_role JWT keys are deprecated by end of 2026.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Deliberately NOT set.
#
# SUPABASE_SECRET_KEY (formerly service_role) bypasses row-level security
# entirely. v1 has no admin surface and no background jobs, so nothing
# needs it. Adding it means one careless server action can undo every RLS
# policy in the project. If something ever genuinely requires it, add it
# server-side only — never with a NEXT_PUBLIC_ prefix.
#
# SUPABASE_SECRET_KEY=sb_secret_...

# NEXT_PUBLIC_ values are inlined at build time. Changing one in Vercel
# does nothing until you redeploy.
