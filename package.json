{
  "name": "paytrackingapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:rls": "node --env-file-if-exists=.env.local --test tests/rls.test.mjs",
    "test:domain": "node --import ./tests/register-alias.mjs --test tests/domain.test.mjs",
    "test": "npm run test:domain && npm run test:budget && npm run test:import && npm run test:ai && npm run test:rls",
    "test:budget": "node --import ./tests/register-alias.mjs --test tests/budget.test.mjs",
    "test:ai": "node --import ./tests/register-alias.mjs --test tests/ai.test.mjs",
    "test:import": "node --import ./tests/register-alias.mjs --test tests/import.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@supabase/ssr": "^0.12.7",
